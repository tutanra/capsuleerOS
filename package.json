{
  "name": "capsuleeros",
  "version": "0.1.2",
  "private": true,
  "description": "Companion de EVE Online para habilidades, mercado, inventario y monedero",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutanra/capsuleerOS.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:mac": "npm run build && electron-builder --mac zip --publish never"
  },
  "build": {
    "appId": "app.capsuleeros.desktop",
    "productName": "capsuleerOS",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png"
    ],
    "asar": true,
    "icon": "icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "tutanra",
        "repo": "capsuleerOS",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "capsuleerOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "capsuleerOS",
      "uninstallDisplayName": "capsuleerOS"
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "capsuleerOS-${version}.${ext}"
    },
    "mac": {
      "icon": "icon.png",
      "target": [
        "zip"
      ],
      "category": "public.app-category.games"
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
